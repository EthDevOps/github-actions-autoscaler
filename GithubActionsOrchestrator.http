@GithubActionsOrchestrator_HostAddress = http://localhost:5178

GET {{GithubActionsOrchestrator_HostAddress}}/weatherforecast/
Accept: application/json

###

# Hold a runner for inspection: protects it from orchestrator deletion and
# registers it in Warpgate (when Warpgate is enabled in the config).
# DELETE the same runner to release the hold and destroy the VM.
#
# When WarpgateAuth is enabled in the config, mutating calls also need the
# identity headers that Warpgate injects (X-Warpgate-Username). In local dev
# you can set them manually, as below.
POST {{GithubActionsOrchestrator_HostAddress}}/api/runners/42/inspect
X-API-KEY: dev-api-key
X-Warpgate-Username: markus
X-Warpgate-Authentication-Types: user

###
